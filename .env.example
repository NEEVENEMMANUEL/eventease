# Copy to .env and adjust per environment.
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql://eventease:eventease@db:5432/eventease

# Postgres container credentials (used by docker-compose)
POSTGRES_USER=eventease
POSTGRES_PASSWORD=eventease
POSTGRES_DB=eventease

# Build info shown in the footer (set by the CI pipeline)
BUILD_NUMBER=local
GIT_SHA=dev
